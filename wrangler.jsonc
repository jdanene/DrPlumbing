{
  "name": "drplumbing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-27",
  "services": [
    {
      "binding": "CONTACT_EMAIL",
      "service": "drplumbing-contact-email"
    }
  ],
  "env": {
    "preview": {
      "services": [
        {
          "binding": "CONTACT_EMAIL",
          "service": "drplumbing-contact-email-preview"
        }
      ]
    }
  }
}
